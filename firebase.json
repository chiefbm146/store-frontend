{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "stores-backend",
          "region": "us-central1"
        }
      },
      {
        "source": "/",
        "destination": "/index.html"
      },
      {
        "source": "/js/**",
        "destination": "/js/**"
      },
      {
        "source": "/css/**",
        "destination": "/css/**"
      },
      {
        "source": "/images/**",
        "destination": "/images/**"
      },
      {
        "source": "/davids store/images/**",
        "destination": "/davids store/images/**"
      },
      {
        "source": "/booking",
        "destination": "/store-booking.html"
      },
      {
        "source": "/booking/**",
        "destination": "/store-booking.html"
      },
      {
        "source": "/about",
        "destination": "/about-desk.html"
      },
      {
        "source": "/about/**",
        "destination": "/about-desk.html"
      },
      {
        "source": "/contact",
        "destination": "/contact-desk.html"
      },
      {
        "source": "/contact/**",
        "destination": "/contact-desk.html"
      },
      {
        "source": "/ai-chat",
        "destination": "/ai-chat-desk.html"
      },
      {
        "source": "/ai-chat/**",
        "destination": "/ai-chat-desk.html"
      },
      {
        "source": "/checkout-success",
        "destination": "/checkout-success.html"
      },
      {
        "source": "/checkout-success/**",
        "destination": "/checkout-success.html"
      },
      {
        "source": "/checkout",
        "destination": "/checkout.html"
      },
      {
        "source": "/checkout/**",
        "destination": "/checkout.html"
      },
      {
        "source": "/portal",
        "destination": "/client-portal.html"
      },
      {
        "source": "/portal/**",
        "destination": "/client-portal.html"
      },
      {
        "source": "/dashboard",
        "destination": "/client-dashboard.html"
      },
      {
        "source": "/dashboard/**",
        "destination": "/client-dashboard.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy-policy.html"
      },
      {
        "source": "/delete",
        "destination": "/delete-data-desk.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/stores",
        "destination": "/stores.html"
      },
      {
        "source": "/stores/**",
        "destination": "/stores.html"
      },
      {
        "source": "/home",
        "destination": "/davids store/davids-main-page.html"
      },
      {
        "source": "/home/**",
        "destination": "/davids store/davids-main-page.html"
      },
      {
        "source": "/davids-about",
        "destination": "/davids store/about.html"
      },
      {
        "source": "/davids-about/**",
        "destination": "/davids store/about.html"
      },
      {
        "source": "/davids-ai",
        "destination": "/davids store/ai.html"
      },
      {
        "source": "/davids-ai/**",
        "destination": "/davids store/ai.html"
      },
      {
        "source": "/checkout-sxexet",
        "destination": "/davids store/checkout-davids.html"
      },
      {
        "source": "/checkout-sxexet/**",
        "destination": "/davids store/checkout-davids.html"
      },
      {
        "source": "/contact-sxexet",
        "destination": "/davids store/contact-david.html"
      },
      {
        "source": "/contact-sxexet/**",
        "destination": "/davids store/contact-david.html"
      },
      {
        "source": "/offerings",
        "destination": "/davids store/offerings.html"
      },
      {
        "source": "/offerings/**",
        "destination": "/davids store/offerings.html"
      },
      {
        "source": "/details",
        "destination": "/davids store/offerings-details.html"
      },
      {
        "source": "/details/**",
        "destination": "/davids store/offerings-details.html"
      },
      {
        "source": "/cart",
        "destination": "/davids store/cart.html"
      },
      {
        "source": "/cart/**",
        "destination": "/davids store/cart.html"
      },
      {
        "source": "/ai-chat-davids.js",
        "destination": "/davids store/ai-chat-davids.js"
      },
      {
        "source": "/workshop-data.js",
        "destination": "/davids store/workshop-data.js"
      },
      {
        "source": "/workshop-loader.js",
        "destination": "/davids store/workshop-loader.js"
      },
      {
        "source": "/aarie-terms",
        "destination": "/aarie-terms.html"
      },
      {
        "source": "/aarie-terms/**",
        "destination": "/aarie-terms.html"
      },
      {
        "source": "/affiliate",
        "destination": "/affiliate.html"
      },
      {
        "source": "/affiliate/**",
        "destination": "/affiliate.html"
      },
      {
        "source": "/affiliate-aarie",
        "destination": "/affiliate-aarie.html"
      },
      {
        "source": "/affiliate-aarie/**",
        "destination": "/affiliate-aarie.html"
      },
      {
        "source": "/affiliate-portal",
        "destination": "/affiliate-portal.html"
      },
      {
        "source": "/affiliate-portal/**",
        "destination": "/affiliate-portal.html"
      },
      {
        "source": "/customer-terms",
        "destination": "/customer-terms.html"
      },
      {
        "source": "/customer-terms/**",
        "destination": "/customer-terms.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      },
      {
        "source": "**/*.png",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/png"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000, s-maxage=2592000"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/jpeg"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000, s-maxage=2592000"
          }
        ]
      },
      {
        "source": "**/*.gif",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/gif"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000, s-maxage=2592000"
          }
        ]
      },
      {
        "source": "**/*.svg",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/svg+xml"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000, s-maxage=2592000"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; img-src 'self' data: https:; font-src 'self' data: https://cdnjs.cloudflare.com; connect-src 'self' https:; media-src 'self' blob: data:; frame-ancestors 'none';"
          }
        ]
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "us-central1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
